# Copie para api/.env e preencha.
DATABASE_URL=postgres://chicken:chicken@localhost:5433/chicken

# Sessão do painel (string aleatória longa)
SESSION_SECRET=

# Cron da Vercel envia este valor em Authorization: Bearer
CRON_SECRET=

# URL de ping do check no Healthchecks.io
HC_PING_URL=

# Bot do Telegram (resumo diário enviado pelo servidor)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
