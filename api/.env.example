# Ambiente de execução: development, test ou production.
NODE_ENV=development
# Conexão do app com o banco; em produção é a URL do pooler do Supabase.
DATABASE_URL=postgres://chicken:chicken@localhost:5433/chicken
# Conexão direta ao banco, usada só nas migrações (db:deploy).
DIRECT_URL=postgres://chicken:chicken@localhost:5433/chicken
# Assinatura do cookie de sessão (string aleatória longa).
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# Segredo que a Vercel envia em Authorization: Bearer no job diário.
CRON_SECRET=troque-por-um-segredo-aleatorio
# Token do bot do Telegram que envia o resumo diário.
TELEGRAM_BOT_TOKEN=123456:token-ficticio
# Conversa do Telegram que recebe os avisos.
TELEGRAM_CHAT_ID=-1000000000000
# Endereço de ping do check no Healthchecks.io.
HC_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# Origem do painel permitida pelo CORS.
WEB_ORIGIN=http://localhost:5173
