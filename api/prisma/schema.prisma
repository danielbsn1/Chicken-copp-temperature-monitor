generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id         String    @id
  name       String
  keyHash    String    @map("key_hash")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  fwVersion  String?   @map("fw_version")
  ownerId    String?   @map("owner_id") @db.Uuid

  owner     User?                 @relation(fields: [ownerId], references: [id])
  readings  Reading[]
  events    Event[]
  summaries DailySummary[]
  pairings  PairingAnnouncement[]

  @@index([ownerId])
  @@map("devices")
}

model Reading {
  deviceId String   @map("device_id")
  ts       DateTime @db.Timestamptz(3)
  tempC    Float    @map("temp_c") @db.Real
  humPct   Float    @map("hum_pct") @db.Real
  fanOn    Boolean  @map("fan_on")

  device Device @relation(fields: [deviceId], references: [id])

  @@id([deviceId, ts])
  @@map("readings")
}

model Event {
  deviceId String   @map("device_id")
  ts       DateTime @db.Timestamptz(3)
  type     String
  detail   Json?

  device Device @relation(fields: [deviceId], references: [id])

  @@id([deviceId, ts, type])
  @@map("events")
}

model DailySummary {
  deviceId       String    @map("device_id")
  day            DateTime  @db.Date
  tempMinC       Float     @map("temp_min_c") @db.Real
  tempMaxC       Float     @map("temp_max_c") @db.Real
  tempAvgC       Float     @map("temp_avg_c") @db.Real
  fanOnMinutes   Int       @map("fan_on_minutes")
  readingsCount  Int       @map("readings_count")
  telegramSentAt DateTime? @map("telegram_sent_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id])

  @@id([deviceId, day])
  @@map("daily_summary")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")

  devices Device[]

  @@map("users")
}

model LoginAttempt {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
  @@map("login_attempts")
}

// SPIKE (descartável): ver docs/spike-prisma-pooler.md
model PoolerProbe {
  id        Int      @id @default(autoincrement())
  nonce     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("pooler_probe")
}

/// Equipamento novo que se anunciou e espera um dono (pareamento).
model PairingAnnouncement {
  serial          String    @id
  keyHash         String    @map("key_hash")
  fwVersion       String    @map("fw_version")
  ip              String
  announcedAt     DateTime  @default(now()) @map("announced_at") @db.Timestamptz(3)
  pairingUntil    DateTime? @map("pairing_until") @db.Timestamptz(3)
  claimedDeviceId String?   @map("claimed_device_id")

  device Device? @relation(fields: [claimedDeviceId], references: [id])

  @@index([ip])
  @@index([announcedAt])
  @@map("pairing_announcements")
}
